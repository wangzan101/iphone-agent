        "weather",
        "Weather"
      ]
    },
    {
      "type": "action_not_taken",
      "texts": [
        "登录",
        "Log in",
        "Sign in",
        "注册",
        "购买",
        "订阅",
        "删除",
        "移除"
      ]
    }
  ]
}
